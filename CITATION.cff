    given-names: Ritanshu
repository-code: "https://github.com/Ritanshu-Prasad/VTAS_Evaluation_Metric"
license: MIT
version: "1.2.0"
date-released: "2026-10-02"
keywords:
  - vision-language-models
  - hallucination-detection
  - evaluation-metric
  - image-captioning
  - object-grounding
  - DETR
  - CLIP
